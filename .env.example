# GoHighLevel API v2 Configuration
# Obtain a Private Integration Token (PIT) or OAuth2 Access Token from your GHL Sub-Account
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Target GoHighLevel Sub-Account (Location) ID
GHL_LOCATION_ID=loc_xxxxxxxxxxxxxxxxxxxx

# Optional API & Rate Limit Settings
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_BURST_LIMIT=90
GHL_BURST_WINDOW_SECONDS=10.0
